MakeChoice(gui, eName, dPol, dPos, dDept, dRole, eBadge) {
    global ProfileFile, DataFolder
    name := eName.Value
    pol := dPol.Text, pos := dPos.Text, dept := dDept.Text, role := dRole.Text, badge := eBadge.Value
    if (!RegExMatch(name, "^[а-яА-ЯёЁ\s-]+$")) {
        MsgBox("Имя только русскими буквами", "Ошибка", "Icon!")
        return
    }
    if (!RegExMatch(badge, "^\d{5}$")) {
        MsgBox("Жетон ровно 5 цифр", "Ошибка", "Icon!")
        return
    }
    if (pol == "" || pos == "" || dept == "" || role == "") {
        MsgBox("Заполните все поля", "Ошибка", "Icon!")
        return
    }
    name := StrReplace(name, "|", " ")
    name := StrReplace(name, "`n", " ")
    name := StrReplace(name, "`r", " ")
    tmpPath := DataFolder . "\DontDeleteCPD.tmp"
    try FileDelete(tmpPath)
    FileAppend(name . "|" . pol . "|" . pos . "|" . dept . "|" . role . "|" . badge . "|RIVV|ToriFoster|LNR|DREX|GZE|GZE", tmpPath, "UTF-8")
    FileMove(tmpPath, ProfileFile, 1)
    Reload()
}

