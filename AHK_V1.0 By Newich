UpdateDeptSign() {
    global Department, SignPTO, SignIRC, SignNUD, SignRTU, SignCPO, DeptSign
    if (Department == "PTO")
        DeptSign := SignPTO
    else if (Department == "IRC")
        DeptSign := SignIRC
    else if (Department == "NUD")
        DeptSign := SignNUD
    else if (Department == "RTU")
        DeptSign := SignRTU
    else if (Department == "CPO")
        DeptSign := SignCPO
    else
        DeptSign := "-"
}

BackupProfile() {
    global ProfileFile, SettingsFile, FinesFile, CodesFile, BackupFolder
    if !FileExist(ProfileFile)
        return
    ts := FormatTime(, "yyyyMMdd_HHmmss")
    try FileCopy(ProfileFile, BackupFolder . "\profile_" . ts . ".bak", 1)
    if FileExist(SettingsFile)
        try FileCopy(SettingsFile, BackupFolder . "\settings_" . ts . ".bak", 1)
    if FileExist(FinesFile)
        try FileCopy(FinesFile, BackupFolder . "\fines_" . ts . ".bak", 1)
    if FileExist(CodesFile)
        try FileCopy(CodesFile, BackupFolder . "\codes_" . ts . ".bak", 1)
    cutoffStr := FormatTime(DateAdd(A_Now, -30, "Days"), "yyyyMMdd")
    Loop Files BackupFolder . "\*.bak"
    {
        if RegExMatch(A_LoopFileName, "(\d{8})", &m) && (m[1] < cutoffStr)
            try FileDelete(A_LoopFileFullPath)
    }
}

