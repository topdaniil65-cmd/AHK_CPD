; ------------------------------------------------------------------------------
; Утилиты
; ------------------------------------------------------------------------------
EscapeJSForScript(s) {
    s := StrReplace(s, "\", "\\")
    s := StrReplace(s, "'", "\'")
    s := StrReplace(s, "`r`n", "\n")
    s := StrReplace(s, "`n", "\n")
    s := StrReplace(s, "`r", "")
    s := StrReplace(s, "`t", "\t")
    return s
}

ExtractMsgPayload(msg) {
    if !IsObject(msg)
        return ""
    try {
        if (Type(msg) == "Map") {
            if msg.Has("data")
                return msg["data"]
            return msg
        }
    }
    try return msg.data
    return msg
}

GetDataField(obj, key, default := "") {
    if !IsObject(obj)
        return default
    try {
        if (Type(obj) == "Map") {
            if obj.Has(key) {
                v := obj[key]
                return (v == "") ? default : v
            }
            return default
        }
    }
    try {
        v := obj.%key%
        return (v == "") ? default : v
    }
    return default
}

ExtractHotkeyKey(msg) {
    if !IsObject(msg)
        return String(msg)
    if (Type(msg) == "Map") {
        if msg.Has("data") {
            d := msg["data"]
            return IsObject(d) ? "" : String(d)
        }
        return ""
    }
    try return String(msg.data)
    return ""
}

