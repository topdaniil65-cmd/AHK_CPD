    Hk := Map()

failedHotkeys := []
for key, handler in Handlers {
    hkVal := Hk.Has(key) ? Hk[key] : ""
    if (hkVal == "" || IsReservedKey(hkVal))
        continue
    try {
        Hotkey(hkVal, handler)
    } catch as e {
        failedHotkeys.Push(key . " (" . hkVal . ")")
    }
}
if (failedHotkeys.Length > 0) {
    logLine := "[" . FormatTime(, "dd.MM.yyyy HH:mm:ss") . "] Не удалось зарегистрировать хоткеи: "
    sep := ""
    for v in failedHotkeys {
        logLine .= sep . v
        sep := ", "
    }
    FileAppend(logLine . "`n", LogFile, "UTF-8")
    TrayTip(
        "Не зарегистрировано хоткеев: " . failedHotkeys.Length
        . "`nПодробнее: " . LogFile,
        "CPD — Внимание", 0x2)
}

if !FileExist(CodesFile)
    CreateDefaultCodes()

if FileExist(ProfileFile) {
    data := FileRead(ProfileFile, "UTF-8")
    info := StrSplit(data, "|")
    if (info.Length < 6) {
        MsgBox("Файл профиля повреждён. Удалите CPD_Data\DontDeleteCPD.txt и перезапустите.", "CPD", "Icon!")
        ExitApp()
    }
    Name        := info[1]
    Pol         := info[2]
    Position    := info[3]
    Department  := info[4]
    DeptRole    := info[5]
    Badge       := info[6]
    SignPTO     := info.Has(7)  ? info[7]  : "RIVV"
    SignIRC     := info.Has(8)  ? info[8]  : "ToriFoster"
    SignNUD     := info.Has(9)  ? info[9]  : "LNR"
    SignRTU     := info.Has(10) ? info[10] : "DREX"
    SignCPO     := info.Has(11) ? info[11] : "GZE"
    SignSheriff := info.Has(12) ? info[12] : "GZE"
    UpdateDeptSign()
    BackupProfile()
    BuildRPActions()
} else {
    ShowInitialSetup()
}
