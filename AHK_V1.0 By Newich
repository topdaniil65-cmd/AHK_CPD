StrToUTF8(str) {
    stream := ""
    result := ""
    try {
        stream := ComObject("ADODB.Stream")
        stream.Type := 2
        stream.Charset := "utf-8"
        stream.Open()
        stream.WriteText(str)
        stream.Position := 0
        stream.Type := 1
        stream.Position := 0
        if (stream.Size >= 3)
            stream.Read(3)
        result := stream.Read()
    } finally {
        try stream.Close()
    }
    return result
}

SendDiscordReport(title, fieldsMap, imagePath := "") {
    global ForumWebhook, Name, ScriptVersion
    if (Trim(ForumWebhook) == "" || ForumWebhook == " ")
        return
        
    embed := Map("title", "📄 " . title, "color", 3447003, "fields", [], "footer", Map("text", "CPD AHK v" . ScriptVersion . " | " . Name), "timestamp", FormatTime(A_NowUTC, "yyyy-MM-ddTHH:mm:ssZ"))
    for k, v in fieldsMap
        embed["fields"].Push(Map("name", k, "value", v, "inline", true))
    payload := Map("thread_name", title . " | " . FormatTime(, "dd.MM.yy HH:mm"), "embeds", [embed])

    if (imagePath != "" && FileExist(imagePath)) {
        embed["image"] := Map("url", "attachment://screenshot.png")
        jsonStr := JSON.stringify(payload)
        boundary := "---------------------------" . A_TickCount
        stream := ComObject("ADODB.Stream")
        fileStream := ComObject("ADODB.Stream")
        postData := ""
        
        try {
            stream.Type := 1
            stream.Open()
            part1 := "--" . boundary . "`r`nContent-Disposition: form-data; name=`"payload_json`"`r`nContent-Type: application/json`r`n`r`n" . jsonStr . "`r`n"
            stream.Write(StrToUTF8(part1))
            part2 := "--" . boundary . "`r`nContent-Disposition: form-data; name=`"file0`"; filename=`"screenshot.png`"`r`nContent-Type: image/png`r`n`r`n"
            stream.Write(StrToUTF8(part2))
            fileStream.Type := 1
            fileStream.Open()
            fileStream.LoadFromFile(imagePath)
            stream.Write(fileStream.Read())
            part3 := "`r`n--" . boundary . "--`r`n"
            stream.Write(StrToUTF8(part3))
            stream.Position := 0
            postData := stream.Read()
        } finally {
            try stream.Close()
            try fileStream.Close()
        }
        
        if (postData != "") {
            whr := ""
            try {
                whr := ComObject("WinHttp.WinHttpRequest.5.1")
                whr.Open("POST", ForumWebhook, false)
