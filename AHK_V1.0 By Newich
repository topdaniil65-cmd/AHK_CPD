LoadStats() {
    global LogFile, StatArrests, StatFines, StatID, StatMiranda, StatFinesSum, StatTotal
    StatArrests := StatFines := StatID := StatMiranda := StatFinesSum := StatTotal := 0
    if !FileExist(LogFile)
        return
    today := FormatTime(, "dd.MM.yyyy")
    prefix := "[" . today
    Loop Read LogFile
    {
        line := A_LoopReadLine
        if (SubStr(line, 1, StrLen(prefix)) != prefix)
            continue
        StatTotal++
        if RegExMatch(line, "Штраф.*\((\d+)\)", &m) {
            StatFines++
            StatFinesSum += Integer(m[1])
        }
        if InStr(line, "Арест")
            StatArrests++
        else if InStr(line, "удостоверение")
            StatID++
        else if InStr(line, "Миранды")
            StatMiranda++
    }
}

