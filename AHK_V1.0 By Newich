; ------------------------------------------------------------------------------
; Сохранение профиля из WebView
; ------------------------------------------------------------------------------
ProcessWebProfile(msg) {
    global ProfileFile, Name, Badge, Pol, Position, Department, DeptRole
    global SignPTO, SignIRC, SignNUD, SignRTU, SignCPO, SignSheriff

    data := ExtractMsgPayload(msg)
    if !IsObject(data) {
        ShowTip("Не удалось прочитать профиль")
        return
    }

    name  := Trim(GetDataField(data, "profName"))
    badge := Trim(GetDataField(data, "profBadge"))
    pol   := Trim(GetDataField(data, "profPol"))
    pos   := Trim(GetDataField(data, "profPos"))
    dept  := Trim(GetDataField(data, "profDept"))
    role  := Trim(GetDataField(data, "profRole"))
    sPTO  := Trim(GetDataField(data, "signPTO",    "RIVV"))
    sIRC  := Trim(GetDataField(data, "signIRC",    "ToriFoster"))
    sNUD  := Trim(GetDataField(data, "signNUD",    "LNR"))
    sRTU  := Trim(GetDataField(data, "signRTU",    "DREX"))
    sCPO  := Trim(GetDataField(data, "signCPO",    "GZE"))
    sSher := Trim(GetDataField(data, "signSheriff","GZE"))

    if (!RegExMatch(name, "^[а-яА-ЯёЁA-Za-z\s-]+$")) {
        ShowTip("Имя: только буквы, пробелы и дефис")
        return
    }
    if (!RegExMatch(badge, "^\d{5}$")) {
        ShowTip("Жетон: ровно 5 цифр")
        return
    }
    if (pol == "" || pos == "" || dept == "" || role == "") {
        ShowTip("Заполните все поля")
        return
    }

    name := StrReplace(name, "|", " ")
    name := StrReplace(name, "`n", " ")
    name := StrReplace(name, "`r", " ")

    line := name . "|" . pol . "|" . pos . "|" . dept . "|" . role . "|" . badge
        . "|" . sPTO . "|" . sIRC . "|" . sNUD . "|" . sRTU . "|" . sCPO . "|" . sSher

    try {
        try FileDelete(ProfileFile)
        FileAppend(line, ProfileFile, "UTF-8")
    } catch as e {
        ShowTip("Не удалось сохранить: " . e.Message)
        return
    }

    Name := name
    Pol := pol
    Position := pos
    Department := dept
    DeptRole := role
    Badge := badge
    SignPTO := sPTO
    SignIRC := sIRC
    SignNUD := sNUD
    SignRTU := sRTU
    SignCPO := sCPO
    SignSheriff := sSher
    UpdateDeptSign()

    ShowTip("Профиль сохранён")
}

; ------------------------------------------------------------------------------
; Сохранение настроек из WebView
; ------------------------------------------------------------------------------
ProcessWebSettings(msg) {
    global SettingsFile, ChatOpenDelay, ChatSendDelay, TransLevel, MinecraftOnly
    global DiscordWebhook, ForumWebhook

    data := ExtractMsgPayload(msg)
    if !IsObject(data) {
        ShowTip("Не удалось прочитать настройки")
        return
    }

    openDelay := 250
    sendDelay := 250
    trans     := 150
    try openDelay := Integer(Trim(GetDataField(data, "setOpen", "250")))
    try sendDelay := Integer(Trim(GetDataField(data, "setSend", "250")))
    try trans     := Integer(Trim(GetDataField(data, "setTrans", "150")))

    mcRaw   := Trim(GetDataField(data, "setMCOnly", "false"))
    discord := Trim(GetDataField(data, "setDiscord", " "))
    forum   := Trim(GetDataField(data, "setForum", " "))

    if (openDelay < 100 || openDelay > 5000) openDelay := 250
    if (sendDelay < 100 || sendDelay > 5000) sendDelay := 250
    if (trans < 50 || trans > 255) trans := 150

    mcVal := (mcRaw = "true" || mcRaw = "True" || mcRaw = "1" || mcRaw = "on") ? 1 : 0

    ChatOpenDelay := openDelay
    ChatSendDelay := sendDelay
    TransLevel    := trans
    MinecraftOnly := mcVal
    DiscordWebhook := discord
    ForumWebhook   := forum

    try IniWrite(openDelay, SettingsFile, "General", "ChatOpenDelay")
    try IniWrite(sendDelay, SettingsFile, "General", "ChatSendDelay")
    try IniWrite(trans,     SettingsFile, "General", "TransLevel")
    try IniWrite(mcVal,     SettingsFile, "General", "MinecraftOnly")
    try IniWrite(discord,   SettingsFile, "General", "DiscordWebhook")
    try IniWrite(forum,     SettingsFile, "General", "ForumWebhook")

    ShowTip("Настройки сохранены")
}

; ------------------------------------------------------------------------------
; Вкладка «Шпаргалка» и «Настройки → Хоткеи»
; ------------------------------------------------------------------------------
BuildHotkeysList() {
    global MenuObj, HkOrder, HkNames, Hk
    if !IsObject(MenuObj)
        return
    html := ""
    for key in HkOrder {
        name := HkNames.Has(key) ? HkNames[key] : key
        human := (Hk.Has(key) && Hk[key] != "") ? GetHumanKey(Hk[key]) : "—"
        html .= "<div class='hk-item'><span>" . name . "</span><b style='color:#8b5cf6;'>" . human . "</b></div>"
    }
    MenuObj.ExecuteScript("document.getElementById('hotkeys-list').innerHTML = '" . EscapeJSForScript(html) . "';")
}

BuildHotkeysSettings() {
    global MenuObj, HkOrder, HkNames, Hk
    if !IsObject(MenuObj)
        return
    html := ""
    for key in HkOrder {
        name := HkNames.Has(key) ? HkNames[key] : key
        human := (Hk.Has(key) && Hk[key] != "") ? GetHumanKey(Hk[key]) : ""
        html .= "<div class='hk-item'><span>" . name . "</span>"
        html .= "<input type='text' id='hk_" . key . "' value='" . human . "' readonly"
        
        ; ВОТ ЗДЕСЬ ИСПРАВЛЕНЫ КАВЫЧКИ (вместо "" теперь `")
        html .= " onclick=`"callAHK('CaptureHotkey','" . key . "')`" style='cursor:pointer;'></div>"
    }
    MenuObj.ExecuteScript("document.getElementById('hk-settings').innerHTML = '" . EscapeJSForScript(html) . "';")
}

; ------------------------------------------------------------------------------
; Захват нового хоткея (клик по полю в настройках)
; ------------------------------------------------------------------------------
CaptureHotkey(msg) {
    global MenuObj, Hk, HkNames, Handlers, SettingsFile

    key := ExtractHotkeyKey(msg)
    if (key == "" || !HkNames.Has(key))
        return

    oldVal := Hk.Has(key) ? Hk[key] : ""

    ib := InputBox(
        "Введите хоткей в синтаксисе AHK v2:`n`n"
        . "  ! = Alt`n  ^ = Ctrl`n  + = Shift`n  # = Win`n`n"
        . "Примеры: !f, ^1, F5, ^+a, !sc020`n`n"
        . "Текущий: " . (oldVal == "" ? "(не задан)" : GetHumanKey(oldVal)),
        "Хоткей — " . HkNames[key],
        "w420 h280", oldVal)

    if (ib.Result != "OK")
        return
    newHk := Trim(ib.Value)
    if (newHk == "")
        return

    if IsReservedKey(newHk) {
        ShowTip("F9/F10 зарезервированы")
        return
    }

    for k, v in Hk {
        if (k != key && v == newHk) {
            ShowTip("Уже используется для: " . HkNames[k])
            return
        }
    }

    if (oldVal != "")
        try Hotkey(oldVal, "Off")

    try {
        Hotkey(newHk, Handlers[key])
        Hk[key] := newHk
        try IniWrite(newHk, SettingsFile, "Hotkeys", key)

        MenuObj.ExecuteScript("document.getElementById('hk_" . key . "').value = '"
            . EscapeJSForScript(GetHumanKey(newHk)) . "';")

        ShowTip("Обновлено: " . GetHumanKey(newHk))
        BuildHotkeysList()
    } catch as e {
        ShowTip("Не удалось: " . e.Message)
        if (oldVal != "")
            try Hotkey(oldVal, Handlers[key])
    }
}

