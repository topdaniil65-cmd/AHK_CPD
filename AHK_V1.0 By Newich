SetDarkMode(hwnd) {
    ; DWMWA_USE_IMMERSIVE_DARK_MODE: 20 = Win10 2004+/Win11, 19 = Win10 pre-2004
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "Int", 20, "Int*", 1, "Int", 4)
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "Int", 19, "Int*", 1, "Int", 4)
}

WM_LBUTTONDOWN(wParam, lParam, msg, hwnd) {
    global MenuObj
    if !IsObject(MenuObj)
        return
    if (hwnd != MenuObj.Hwnd)
        return
    PostMessage(0xA1, 2, 0, , "ahk_id " . hwnd)
}

; ------------------------------------------------------------------------------
; Скрытие / показ интерфейса
; ------------------------------------------------------------------------------
HideWindow(*) {
    global MenuObj, isHiddenUI, TransLevel
    if !IsObject(MenuObj) || !WinExist("ahk_id " . MenuObj.Hwnd)
        return
    isHiddenUI := !isHiddenUI
    if isHiddenUI {
        js := ""
        js .= "document.querySelectorAll('.nav-btn').forEach(b => b.style.display = 'none');"
        js .= "document.querySelectorAll('.tab-content').forEach(t => { if (t.id !== 'tab1') t.style.display = 'none'; });"
        js .= "var t1 = document.getElementById('tab1');"
        js .= "if (t1) { t1.style.top = '15px'; t1.style.display = 'block'; t1.classList.add('active'); }"
        js .= "var btn = document.getElementById('btnHide');"
        js .= "if (btn) btn.textContent = 'Показать интерфейс';"
        MenuObj.ExecuteScript(js)
        try WinSetTransparent(TransLevel, "ahk_id " . MenuObj.Hwnd)
    } else {
        js := ""
        js .= "document.querySelectorAll('.nav-btn').forEach(b => b.style.display = '');"
        js .= "document.querySelectorAll('.tab-content').forEach(t => { if (t.id !== 'tab1') t.style.display = ''; });"
        js .= "var t1 = document.getElementById('tab1');"
        js .= "if (t1) { t1.style.top = '80px'; t1.style.display = ''; }"
        js .= "var btn = document.getElementById('btnHide');"
        js .= "if (btn) btn.textContent = 'Скрыть интерфейс';"
        MenuObj.ExecuteScript(js)
        try WinSetTransparent("Off", "ahk_id " . MenuObj.Hwnd)
    }
}
