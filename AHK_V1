LoadCodes() {
    global CodesFile
    codes := {}
    codes["Уголовный"] := []
    codes["Административный"] := []
    if !FileExist(CodesFile)
        return codes
    section := ""
    Loop, Read, %CodesFile%
    {
        line := Trim(A_LoopReadLine)
        if (line = "" || SubStr(line, 1, 1) = ";")
            continue
        if (SubStr(line, 1, 1) = "[" && SubStr(line, 0, 1) = "]") {
            section := Trim(SubStr(line, 2, StrLen(line) - 2))
            if !codes.HasKey(section)
                codes[section] := []
            continue
        }
        if (section = "")
            continue
        pos := InStr(line, "=")
        if (!pos)
            continue
        num  := Trim(SubStr(line, 1, pos - 1))
        rest := Trim(SubStr(line, pos + 1))
        pos2 := InStr(rest, "|")
        if (pos2) {
            artName := Trim(SubStr(rest, 1, pos2 - 1))
            val     := Trim(SubStr(rest, pos2 + 1))
        } else {
            artName := rest
            val     := "0"
        }
        if (num = "" || artName = "")
            continue
        codes[section].Push({num: num, name: artName, extra: val})
    }
    return codes
}

