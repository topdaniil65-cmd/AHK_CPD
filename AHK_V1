ViewPhrasesGUI:
LoadPhrases()
Gui, Phrases: Destroy
Gui, Phrases: New, +AlwaysOnTop +LabelPhrasesGui
Gui, Phrases: Color, %BG%
Gui, Phrases: Font, s10 %TxtC%, Roboto
Gui, Phrases: Add, Text, x15 y10 w400 +BackgroundTrans, Шаблоны (двойной клик — отправить):
Gui, Phrases: Add, Edit, x15 y35 w400 vPhraseCustom BackgroundFFFFFF cBlack
Gui, Phrases: Add, Button, x420 y35 w80 h24 gAddPhrase, Добавить
Gui, Phrases: Add, ListBox, x15 y70 w485 h200 vPhraseList gSendPhrase BackgroundFFFFFF cBlack, % ""
Gui, Phrases: Show, w510 h290, Быстрые фразы
GoSub, ReloadPhrases
Return

PhrasesGuiClose:
Gui, Phrases: Destroy
Return

ReloadPhrases:
Gui, Phrases: Default
GuiControl, Phrases:, PhraseList, |
Loop, Read, %PhrasesFile%
{
    line := Trim(A_LoopReadLine)
    if (line = "")
        continue
    GuiControl, Phrases:, PhraseList, %line%
}
Return

AddPhrase:
Gui, Phrases: Submit, NoHide
if (Trim(PhraseCustom) = "")
    Return
FileAppend, %PhraseCustom%`n, %PhrasesFile%
GuiControl, Phrases:, PhraseCustom,
GoSub, ReloadPhrases
Return

SendPhrase:
Gui, Phrases: Submit, NoHide
if (PhraseList = "")
    Return
phraseToSend := PhraseList
Gui, Phrases: Destroy
Sleep, 250
SendChat(phraseToSend)
Return
