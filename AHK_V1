ReloadArrests:
Gui, Arrests: Default
LV_Delete()
if !FileExist(ArrestsFile)
    Return
Loop, Read, %ArrestsFile%
{
    line := A_LoopReadLine
    if RegExMatch(line, "^\[(.+?)\]\s*(.+)$", fullM) {
        d := fullM1
        rest := fullM2
        if RegExMatch(rest, "^\[готово\]\s*(.+)$", prep) {
            LV_Add("", d, "готово", prep1)
        } else if RegExMatch(rest, "^\*(\d+)\s*[—–-]\s*(.*)$", star) {
            LV_Add("", d, "*" . star1, star2)
        } else if RegExMatch(rest, "^(.+?),\s*(.*)$", inner) {
            LV_Add("", d, "—", inner1 . " — " . inner2)
        } else {
            LV_Add("", d, "—", rest)
        }
    }
}
LV_ModifyCol(1, 130)
LV_ModifyCol(2, 70)
LV_ModifyCol(3, 350)
Return

FilterArrests:
Gui, Arrests: Submit, NoHide
Gui, Arrests: Default
LV_Delete()
if !FileExist(ArrestsFile)
    Return
needle := ArrestsSearch
Loop, Read, %ArrestsFile%
{
    line := A_LoopReadLine
    if (needle != "" && !InStr(line, needle))
        continue
    if RegExMatch(line, "^\[(.+?)\]\s*(.+)$", fullM) {
        d := fullM1
        rest := fullM2
        if RegExMatch(rest, "^\[готово\]\s*(.+)$", prep) {
            LV_Add("", d, "готово", prep1)
        } else if RegExMatch(rest, "^\*(\d+)\s*[—–-]\s*(.*)$", star) {
            LV_Add("", d, "*" . star1, star2)
        } else if RegExMatch(rest, "^(.+?),\s*(.*)$", inner) {
            LV_Add("", d, "—", inner1 . " — " . inner2)
        } else {
            LV_Add("", d, "—", rest)
        }
    }
}
Return

ExportArrests:
if !FileExist(ArrestsFile) {
    MsgBox, 64, Инфо, База пуста
    Return
}
FormatTime, ts,, yyyyMMdd_HHmmss
csv := DataFolder . "\Arrests_" . ts . ".csv"
FileDelete, %csv%
FileAppend, `"Дата`",`"Статус`",`"Статьи`"`n, %csv%
Loop, Read, %ArrestsFile%
{
    line := A_LoopReadLine
    if RegExMatch(line, "^\[(.+?)\]\s*(.*)$", fullM) {
        d := fullM1
        rest := fullM2
        if RegExMatch(rest, "^\[готово\]\s*(.+)$", prep) {
            FileAppend, `"%d%`",`"готово`",`"%prep1%`"`n, %csv%
        } else if RegExMatch(rest, "^\*(\d+)\s*[—–-]\s*(.*)$", star) {
            FileAppend, `"%d%`",`"*%star1%`",`"%star2%`"`n, %csv%
        } else {
            FileAppend, `"%d%`",`"`",`"%rest%`"`n, %csv%
        }
    }
}
Sleep, 200
if FileExist(csv)
    Run, notepad.exe "%csv%"
else
    MsgBox, 16, Ошибка, Не удалось создать CSV
Return

