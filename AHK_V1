BackupProfile() {
    global ProfileFile, SettingsFile, FinesFile, CodesFile, BackupFolder
    if !FileExist(ProfileFile)
        return
    FormatTime, ts,, yyyyMMdd_HHmmss
    FileCopy, %ProfileFile%,  %BackupFolder%\profile_%ts%.bak,  1
    if FileExist(SettingsFile)
        FileCopy, %SettingsFile%, %BackupFolder%\settings_%ts%.bak, 1
    if FileExist(FinesFile)
        FileCopy, %FinesFile%,    %BackupFolder%\fines_%ts%.bak,    1
    if FileExist(CodesFile)
        FileCopy, %CodesFile%,    %BackupFolder%\codes_%ts%.bak,    1
    EnvAdd, cutoff, -30, Days
    FormatTime, cutoffStr, %cutoff%, yyyyMMdd
    Loop, Files, %BackupFolder%\*.bak
    {
        name := A_LoopFileName
        if RegExMatch(name, "_(\d{8})_", m) {
            if (m1 < cutoffStr)
                FileDelete, %A_LoopFileFullPath%
        }
    }
}

LoadFines() {
    global FinesFile, FineMap
    if !FileExist(FinesFile) {
        FileAppend, `; Название=Сумма`nПревышение скорости=5000`nЕзда без прав=15000`nНеповиновение сотруднику=10000`nПарковка в неположенном месте=3000`n, %FinesFile%
    }
    FineMap := {}
    list := ""
    Loop, Read, %FinesFile%
    {
        line := Trim(A_LoopReadLine)
        if (line = "" || SubStr(line, 1, 1) = ";")
            continue
        pos := InStr(line, "=")
        if !pos
            continue
        name := Trim(SubStr(line, 1, pos - 1))
        sum  := Trim(SubStr(line, pos + 1))
        if (name = "")
            continue
        FineMap[name] := sum
        list .= name . "|"
    }
    return RTrim(list, "|")
}

