CheckUpdates() {
    global UpdateURL, ScriptVersion, ScriptURL, DataFolder
    if InStr(UpdateURL, "ВАШ_") || UpdateURL = ""
        return
    if !InStr(UpdateURL, "http")
        return
    try {
        whr := ComObjCreate("WinHttp.WinHttpRequest.5.1")
        whr.SetTimeouts(3000, 3000, 3000, 3000)
        whr.Open("GET", UpdateURL, false)
        whr.Send()
        if (whr.Status = 200) {
            LatestVer := Trim(whr.ResponseText)
            if (LatestVer != "" && LatestVer != ScriptVersion && InStr(LatestVer, "404") = 0) {
                MsgBox, 36, Обновление, Доступна новая версия АХК (%LatestVer%)!`nВаша версия: %ScriptVersion%`n`nСкачать?
                IfMsgBox, Yes
                    Run, %ScriptURL%
            }
        }
    } catch {
    }
}

SanitizeJSON(str) {
    str := StrReplace(str, "\", "\\")
    str := StrReplace(str, """", "\""")
    str := StrReplace(str, "`n", "\n")
    str := StrReplace(str, "`r", "")
    str := StrReplace(str, "`t", "\t")
    return str
}

StrToUTF8(str) {
    stream := ComObjCreate("ADODB.Stream")
    stream.Type := 2
    stream.Charset := "utf-8"
    stream.Open()
    stream.WriteText(str)
    stream.Position := 0
    stream.Type := 1
    stream.Position := 0
    
    if (stream.Size >= 3) {
        stream.Read(3)
    }
    return stream.Read()
}

SendDiscord(content) {
    global DiscordWebhook
    if (Trim(DiscordWebhook) = "")
        return
    try {
        safeContent := SanitizeJSON(content)
        body := "{""content"":""" . safeContent . """}"
        whr := ComObjCreate("WinHttp.WinHttpRequest.5.1")
        whr.SetTimeouts(3000, 3000, 3000, 3000)
        whr.Open("POST", DiscordWebhook, false)
        whr.SetRequestHeader("Content-Type", "application/json")
        whr.Send(body)
    }
}

SendDiscordMedia(webhookUrl, title, content, filePath) {
    if (Trim(webhookUrl) = "" || !FileExist(filePath))
        return false

    safeTitle := SanitizeJSON(title)
    safeContent := SanitizeJSON(content)
    json := "{""content"": ""**" . safeTitle . "**\n" . safeContent . """}"

    boundary := "AHK_BOUNDARY_" . A_TickCount

    stream := ComObjCreate("ADODB.Stream")
    stream.Type := 1
    stream.Open()

    jsonPart := "--" . boundary . "`r`n"
    jsonPart .= "Content-Disposition: form-data; name=""payload_json""`r`n"
    jsonPart .= "Content-Type: application/json`r`n`r`n"
    jsonPart .= json . "`r`n"
    stream.Write(StrToUTF8(jsonPart))

    filePart := "--" . boundary . "`r`n"
    filePart .= "Content-Disposition: form-data; name=""file""; filename=""image.png""`r`n"
    filePart .= "Content-Type: image/png`r`n`r`n"
    stream.Write(StrToUTF8(filePart))

    fileStream := ComObjCreate("ADODB.Stream")
    fileStream.Type := 1
    fileStream.Open()
    try {
        fileStream.LoadFromFile(filePath)
        stream.Write(fileStream.Read())
    } catch {
        fileStream.Close()
        stream.Close()
        return false
    }
    fileStream.Close()

    tail := "`r`n--" . boundary . "--`r`n"
    stream.Write(StrToUTF8(tail))

    stream.Position := 0
    postData := stream.Read()
    stream.Close()

    try {
        whr := ComObjCreate("WinHttp.WinHttpRequest.5.1")
        whr.SetTimeouts(5000, 5000, 5000, 5000)
        whr.Open("POST", webhookUrl, false)
        whr.SetRequestHeader("Content-Type", "multipart/form-data; boundary=" . boundary)
        whr.Send(postData)

        if (whr.Status >= 200 && whr.Status < 300) {
            return true
        } else {
            errCode := whr.Status
            ; Убрали блокирующий MsgBox
            ShowTip("Ошибка Discord: " . errCode, 3000)
            return false
        }
    } catch e {
        ShowTip("Ошибка отправки: " . e.Message, 3000)
        return false
    }
}

