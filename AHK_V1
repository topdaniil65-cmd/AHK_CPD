Global StatArrests, StatFines, StatID, StatMiranda, StatFinesSum, StatTotal

LoadStats() {
    global LogFile, StatArrests, StatFines, StatID, StatMiranda, StatFinesSum, StatTotal
    StatArrests := 0, StatFines := 0, StatID := 0, StatMiranda := 0
    StatFinesSum := 0, StatTotal := 0
    if !FileExist(LogFile)
        return
    FormatTime, today,, dd.MM.yyyy
    prefix := "[" . today
    Loop, Read, %LogFile%
    {
        line := A_LoopReadLine
        if (SubStr(line, 1, StrLen(prefix)) != prefix)
            continue
        StatTotal++
        if InStr(line, "Арест")
            StatArrests++
        else if InStr(line, "Штраф") {
            StatFines++
            if RegExMatch(line, "\((\d+)\)", m)
                StatFinesSum += m1
        }
        else if InStr(line, "удостоверение")
            StatID++
        else if InStr(line, "Миранды")
            StatMiranda++
    }
}

Gdip_Startup() {
    if !DllCall("GetModuleHandle", "str", "gdiplus", "Ptr")
        DllCall("LoadLibrary", "str", "gdiplus", "Ptr")
    VarSetCapacity(si, A_PtrSize = 8 ? 24 : 16, 0)
    NumPut(1, si, 0, "UInt")
    DllCall("gdiplus\GdiplusStartup", "Ptr*", pToken, "Ptr", &si, "Ptr", 0)
    return pToken
}
Gdip_Shutdown(pToken) {
    DllCall("gdiplus\GdiplusShutdown", "Ptr", pToken)
    if hModule := DllCall("GetModuleHandle", "str", "gdiplus", "Ptr")
        DllCall("FreeLibrary", "Ptr", hModule)
}
Gdip_BitmapFromScreen(Screen=0) {
    if (Screen = 0) {
        SysGet, x, 76
        SysGet, y, 77
        SysGet, w, 78
        SysGet, h, 79
    } else {
        StringSplit, S, Screen, |
        x := S1, y := S2, w := S3, h := S4
    }
    hdc := DllCall("GetDC", "Ptr", 0, "Ptr")
    hdcMem := DllCall("CreateCompatibleDC", "Ptr", hdc, "Ptr")
    hbm := DllCall("CreateCompatibleBitmap", "Ptr", hdc, "Int", w, "Int", h, "Ptr")
    obm := DllCall("SelectObject", "Ptr", hdcMem, "Ptr", hbm, "Ptr")
    DllCall("BitBlt", "Ptr", hdcMem, "Int", 0, "Int", 0, "Int", w, "Int", h, "Ptr", hdc, "Int", x, "Int", y, "UInt", 0x00CC0020)
    DllCall("SelectObject", "Ptr", hdcMem, "Ptr", obm)
    DllCall("DeleteDC", "Ptr", hdcMem)
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdc)
    DllCall("gdiplus\GdipCreateBitmapFromHBITMAP", "Ptr", hbm, "Ptr", 0, "Ptr*", pBitmap)
    DllCall("DeleteObject", "Ptr", hbm)
    return pBitmap
}
Gdip_SaveBitmapToFile(pBitmap, sOutput) {
    SplitPath, sOutput,,, sExt
    StringLower, sExt, sExt
    sGUID := (sExt = "jpg" || sExt = "jpeg") ? "{557CF401-1A04-11D3-9A73-0000F81EF32E}" : "{557CF406-1A04-11D3-9A73-0000F81EF32E}"
    VarSetCapacity(pGUID, 16, 0)
    DllCall("ole32\CLSIDFromString", "WStr", sGUID, "Ptr", &pGUID)
    DllCall("gdiplus\GdipSaveImageToFile", "Ptr", pBitmap, "WStr", sOutput, "Ptr", &pGUID, "UInt", 0)
}
DrawWatermark(pBitmap, text) {
    DllCall("gdiplus\GdipGetImageGraphicsContext", "Ptr", pBitmap, "Ptr*", pGraphics)
    DllCall("gdiplus\GdipCreateSolidFill", "UInt", 0xCCFFFFFF, "Ptr*", pBrush)
    DllCall("gdiplus\GdipCreateFontFamilyFromName", "WStr", "Arial", "UInt", 0, "Ptr*", hFamily)
    DllCall("gdiplus\GdipCreateFont", "Ptr", hFamily, "Float", 22, "Int", 1, "Int", 3, "Ptr*", hFont)
    DllCall("gdiplus\GdipDeleteFontFamily", "Ptr", hFamily)
    VarSetCapacity(rectF, 16, 0)
    NumPut(20.0, rectF, 0, "Float")
    NumPut(20.0, rectF, 4, "Float")
    NumPut(1500.0, rectF, 8, "Float")
    NumPut(60.0, rectF, 12, "Float")
    DllCall("gdiplus\GdipDrawString", "Ptr", pGraphics, "WStr", text, "Int", -1, "Ptr", hFont, "Ptr", &rectF, "Ptr", 0, "Ptr", pBrush)
    DllCall("gdiplus\GdipDeleteBrush", "Ptr", pBrush)
    DllCall("gdiplus\GdipDeleteFont", "Ptr", hFont)
    DllCall("gdiplus\GdipDeleteGraphics", "Ptr", pGraphics)
}
Gdip_SaveScreenWithWatermark(path, text) {
    pToken := Gdip_Startup()
    if !pToken
        return
    pBitmap := Gdip_BitmapFromScreen(0)
    DrawWatermark(pBitmap, text)
    Gdip_SaveBitmapToFile(pBitmap, path)
    DllCall("gdiplus\GdipDisposeImage", "Ptr", pBitmap)
    Gdip_Shutdown(pToken)
}

