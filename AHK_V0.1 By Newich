            fileStream.Type := 1
            fileStream.Open()
            fileStream.LoadFromFile(imagePath)
            stream.Write(fileStream.Read())
            part3 := "`r`n--" . boundary . "--`r`n"
            stream.Write(StrToUTF8(part3))
            stream.Position := 0
            postData := stream.Read()
        } finally {
            try stream.Close()
            try fileStream.Close()
        }
        
        if (postData != "") {
            whr := ""
            try {
                whr := ComObject("WinHttp.WinHttpRequest.5.1")
                whr.Open("POST", ForumWebhook, false)
                whr.SetRequestHeader("Content-Type", "multipart/form-data; boundary=" . boundary)
                whr.Send(postData)
            } catch {
            } finally {
                try whr := ""
            }
        }
    } else {
        jsonStr := JSON.stringify(payload)
        whr := ""
        try {
            whr := ComObject("WinHttp.WinHttpRequest.5.1")
            whr.Open("POST", ForumWebhook, false)
            whr.SetRequestHeader("Content-Type", "application/json")
            whr.Send(jsonStr)
        } catch {
        } finally {
            try whr := ""
        }
    }
}
