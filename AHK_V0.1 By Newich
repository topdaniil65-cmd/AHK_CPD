GetHumanKey(k) {
    if (k == "")
        return ""
    k := Trim(k)
    out := ""
    Loop {
        ch := SubStr(k, 1, 1)
        if (ch == "!") {
            out .= "Alt+", k := SubStr(k, 2)
        } else if (ch == "^") {
            out .= "Ctrl+", k := SubStr(k, 2)
        } else if (ch == "+") {
            out .= "Shift+", k := SubStr(k, 2)
        } else if (ch == "#") {
            out .= "Win+", k := SubStr(k, 2)
        } else break
    }
    if RegExMatch(k, "i)^sc([0-9a-f]+)$", &m) {
        vk := DllCall("MapVirtualKey", "UInt", "0x" . m[1], "UInt", 3)
        if (vk)
            k := GetKeyName("vk" . Format("{:X}", vk))
    }
    return out . k
}

IsReservedKey(k) {
    if (k == "")
        return false
    k := StrReplace(k, "~")
    k := StrReplace(k, "$")
    k := StrReplace(k, "*")
    kU := StrUpper(k)
    return (kU == "F8" || kU == "F9" || kU == "F10")
}

