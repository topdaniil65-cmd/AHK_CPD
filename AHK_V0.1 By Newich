    if WinActive("Управление CPD") || WinActive("Действие") || WinActive("Данные задержанного")
        || WinActive("Штраф") || WinActive("Введите информацию") || WinActive("Арест")
        || WinActive("База арестов") || WinActive("Смена хоткея")
        return 0

