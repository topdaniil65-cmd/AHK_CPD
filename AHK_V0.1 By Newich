; --- АСИНХРОННАЯ ЗАГРУЗКА ПОДПИСЕЙ ---
CheckSignaturesStatus() {
    global AsyncSignRequest, SignPTO, SignIRC, SignNUD, SignRTU, SignCPO, SignSheriff, MenuObj
    
    try {
        AsyncSignRequest.WaitForResponse(0)
    } catch {
        return 
    }
        
    SetTimer(CheckSignaturesStatus, 0)
    try {
        if (AsyncSignRequest.Status == 200) {
            jsonStr := AsyncSignRequest.ResponseText
            data := JSON.parse(jsonStr)
            if IsObject(data) {
                if data.Has("SignPTO")     SignPTO := data["SignPTO"]
                if data.Has("SignIRC")     SignIRC := data["SignIRC"]
                if data.Has("SignNUD")     SignNUD := data["SignNUD"]
