LoadFines() {
    global FinesFile, FineMap
    if !FileExist(FinesFile)
        FileAppend("; Название=Сумма`nПревышение скорости=5000`nЕзда без прав=15000`nНеповиновение сотруднику=10000`nПарковка в неположенном месте=3000`n", FinesFile, "UTF-8")
    FineMap := Map()
    list := ""
    try {
        Loop Read FinesFile
        {
            line := Trim(A_LoopReadLine)
            if (line == "" || SubStr(line, 1, 1) == ";")
                continue
            pos := InStr(line, "=")
            if !pos
                continue
            name := Trim(SubStr(line, 1, pos - 1))
            if (name == "")
                continue
            FineMap[name] := Trim(SubStr(line, pos + 1))
            list .= name . "|"
        }
    } catch as e {
        ShowTip("Не удалось прочитать fines.ini: " . e.Message)
    }
    return RTrim(list, "|")
}

CreateDefaultCodes() {
    global CodesFile
    if FileExist(CodesFile)
        return
    body := ""
    body .= "[Административный]`n"
    body .= "1.1=Нарушение общественного порядка|1000`n"
    body .= "2.5=Парковка в неположенном месте|5000`n"
    body .= "[Уголовный]`n"
    body .= "5.1=[Гл.5] Убийство — умышленное причинение смерти другому лицу (2 года)`n"
    body .= "8.2=[Гл.8] Кража — тайное хищение чужого имущества (1 год)`n"
    FileAppend(body, CodesFile, "UTF-8")
}

LoadCodes() {
    global CodesFile
    codes := Map("Уголовный", [], "Административный", [])
    if !FileExist(CodesFile)
        return codes
    section := ""
    Loop Read CodesFile
    {
        line := Trim(A_LoopReadLine)
        if (line == "" || SubStr(line, 1, 1) == ";")
            continue
        if (SubStr(line, 1, 1) == "[" && SubStr(line, -1) == "]") {
            section := Trim(SubStr(line, 2, StrLen(line) - 2))
            if !codes.Has(section)
                codes[section] := []
            continue
        }
        if (section == "")
            continue
        pos := InStr(line, "=")
        if (!pos)
            continue
        num  := Trim(SubStr(line, 1, pos - 1))
        rest := Trim(SubStr(line, pos + 1))
        pos2 := InStr(rest, "|")
        if (pos2) {
            artName := Trim(SubStr(rest, 1, pos2 - 1))
            val     := Trim(SubStr(rest, pos2 + 1))
        } else {
            artName := rest
            val     := "0"
        }
        if (num == "" || artName == "")
            continue
        codes[section].Push(Map("num", num, "name", artName, "extra", val))
    }
    return codes
}
