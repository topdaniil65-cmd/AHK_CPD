RefreshHotkeyUI(key) {
    global MenuObj, Hk
    if !IsObject(MenuObj)
        return
    val := Hk.Has(key) ? Hk[key] : ""
    human := (val == "") ? "Не задано" : GetHumanKey(val)
    try MenuObj.ExecuteScript("document.getElementById('hk_" . key . "').value = " . JSON.stringify(human) . ";")
}

CaptureHotkey(msg) {
    key := ExtractMsgPayload(msg)
    if (key == "" || !HkNames.Has(key))
        return
    ; Увеличиваем задержку до 100 мс, чтобы WebView успел полностью отпустить поток JS
    SetTimer(ShowCaptureGui.Bind(key), -100)
}

FocusWebView() {
    global MenuObj
    if IsObject(MenuObj) && WinExist("ahk_id " . MenuObj.Hwnd) {
        try WinActivate("ahk_id " . MenuObj.Hwnd)
        Sleep(100) ; Ждем, пока окно активируется
        try MenuObj.ExecuteScript("window.focus(); document.body.focus();")
    }
}

ShowCaptureGui(key) {
    global Hk, HkNames, HotkeysPaused

    savedHk := Map()
    for k, v in Hk {
        savedHk[k] := v
        if (v != "")
            try Hotkey(v, "Off")
    }

    capGui := Gui("+AlwaysOnTop -MinimizeBox -MaximizeBox", "Смена хоткея")
    capGui.BackColor := "0x1A1A1A"
    capGui.SetFont("s11 cWhite", "Segoe UI")
    capGui.AddText("x20 y15 w300", "Действие: " . HkNames[key])
    capGui.AddText("x20 y40 w300 cGray", "Нажмите комбинацию:")

    hkCtrl := capGui.Add("Hotkey", "x20 y70 w300 Background000000 cWhite")
    if (Hk.Has(key) && Hk[key] != "")
        hkCtrl.Value := Hk[key]

    capGui.AddButton("x20 y110 w140 h30 Default", "Сохранить").OnEvent("Click", (*) => FinishCaptureHotkey(capGui, key, hkCtrl.Value, savedHk))
    capGui.AddButton("x180 y110 w140 h30", "Очистить").OnEvent("Click", (*) => FinishCaptureHotkey(capGui, key, "", savedHk))
    capGui.AddButton("x20 y150 w300 h28", "Отмена").OnEvent("Click", (*) => CancelCaptureHotkey(capGui, savedHk))
    capGui.OnEvent("Close", (*) => CancelCaptureHotkey(capGui, savedHk))

    capGui.Show("w340 h195")
}

CancelCaptureHotkey(capGui, savedHk) {
    global Hk, Handlers
    try capGui.Destroy()
    RestoreAllHotkeys(savedHk)
    FocusWebView()
}

FinishCaptureHotkey(capGui, key, newHk, savedHk) {
    global Hk, HkNames, SettingsFile

    try capGui.Destroy()
    newHk := Trim(newHk)

    if !ValidateHotkey(key, newHk, HkNames) {
        RestoreAllHotkeys(savedHk)
        FocusWebView()
        return
    }

    Hk[key] := newHk
    try IniWrite(newHk, SettingsFile, "Hotkeys", key)

    RestoreAllHotkeys(savedHk)
    RefreshHotkeyUI(key)
    BuildHotkeysList()
    ShowTip(newHk == "" ? "Хоткей очищен" : "Хоткей сохранён")
    FocusWebView()
}

ValidateHotkey(key, newHk, HkNames) {
    global Hk
    if (newHk == "")
        return true
    if IsReservedKey(newHk) {
        ShowTip("F8–F10 зарезервированы")
        return false
    }
    for k, v in Hk {
        if (k != key && v == newHk) {
            ShowTip("Уже занято: " . (HkNames.Has(k) ? HkNames[k] : k))
            return false
        }
    }
    return true
}

RestoreAllHotkeys(sourceMap) {
    global Hk, Handlers
    ; Перерегистрируем строго из актуального Hk
    for k, v in Hk {
        if (v != "" && !IsReservedKey(v)) {
            try Hotkey(v, Handlers[k])
        }
    }
}

ApplyNewHotkey(msg) {
    global MenuObj, Hk, HkNames, Handlers, SettingsFile

    data := ExtractMsgPayload(msg)
    if !IsObject(data)
        return

    key := GetDataField(data, "key")
    newHk := Trim(GetDataField(data, "hotkey"))
    
    if (key == "" || !HkNames.Has(key))
        return

    if (newHk != "" && IsReservedKey(newHk)) {
        ShowTip("Зарезервировано!")
        return
    }

    if (newHk != "") {
        for k, v in Hk {
            if (k != key && v == newHk) {
                ShowTip("Занято: " . HkNames[k])
                return
            }
        }
    }

    oldVal := Hk.Has(key) ? Hk[key] : ""
    if (oldVal != "") {
        try Hotkey(oldVal, "Off")
    }

    try {
        if (newHk != "") {
            Hotkey(newHk, Handlers[key])
            Hk[key] := newHk
            try IniWrite(newHk, SettingsFile, "Hotkeys", key)
        } else {
            Hk[key] := ""
            try IniWrite("", SettingsFile, "Hotkeys", key)
        }
        
        for k, v in Hk {
            if (v != "" && !IsReservedKey(v)) {
                try Hotkey(v, Handlers[k])
            }
        }
        
        RefreshHotkeyUI(key)
        BuildHotkeysList()
        ShowTip("Сохранено")
    } catch as e {
        MsgBox("Не удалось зарегистрировать комбинацию!`nВозможно, она занята.", "Ошибка", 16)
    }
}
