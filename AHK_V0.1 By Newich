; --- АСИНХРОННАЯ ПРОВЕРКА ОБНОВЛЕНИЙ ---
CheckForUpdates() {
    global ScriptVersion, AsyncUpdateRequest
    url := "https://raw.githubusercontent.com/topdaniil65-cmd/AHK_CPD/main/version.json"
    try {
        AsyncUpdateRequest := ComObject("WinHttp.WinHttpRequest.5.1")
        AsyncUpdateRequest.Open("GET", url, true) ; true = асинхронный режим
        AsyncUpdateRequest.Send()
        SetTimer(CheckUpdateStatus, 200)
    } catch {
    }
}

CheckUpdateStatus() {
    global AsyncUpdateRequest, ScriptVersion
    
    try {
        AsyncUpdateRequest.WaitForResponse(0)
    } catch {
        return 
    }
    
    SetTimer(CheckUpdateStatus, 0) ; Останавливаем опрос
    try {
        if (AsyncUpdateRequest.Status == 200) {
            data := JSON.parse(AsyncUpdateRequest.ResponseText)
            if IsObject(data) && data.Has("latest_version") && data.Has("download_url") {
                remoteVersion := data["latest_version"]
                downloadUrl := data["download_url"]
                
                if (remoteVersion != ScriptVersion) {
                    result := MsgBox("Доступна новая версия CPD AHK!`n`nТекущая: " . ScriptVersion . "`nНовая: " . remoteVersion . "`n`nОбновить скрипт сейчас?", "CPD — Обновление", "YesNo Icon!")
                    if (result == "Yes")
                        DownloadUpdate(downloadUrl)
                }
            }
        }
    } catch {
    }
}

