StrToUTF8(str) {
    stream := ""
    result := ""
    try {
        stream := ComObject("ADODB.Stream")
        stream.Type := 2
        stream.Charset := "utf-8"
        stream.Open()
        stream.WriteText(str)
        stream.Position := 0
        stream.Type := 1
        stream.Position := 0
        if (stream.Size >= 3)
            stream.Read(3)
        result := stream.Read()
    } finally {
        try stream.Close()
    }
    return result
}

