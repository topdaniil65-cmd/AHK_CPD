; ------------------------------------------------------------------------------
; Сохранение профиля из WebView
; ------------------------------------------------------------------------------
ProcessWebProfile(msg) {
    global ProfileFile, Name, Badge, Pol, Position, Department, DeptRole
    global SignPTO, SignIRC, SignNUD, SignRTU, SignCPO, SignSheriff

    data := ExtractMsgPayload(msg)
    if !IsObject(data) {
        return
    }

    name  := Trim(GetDataField(data, "profName"))
    badge := Trim(GetDataField(data, "profBadge"))
    pol   := Trim(GetDataField(data, "profPol"))
    pos   := Trim(GetDataField(data, "profPos"))
    dept  := Trim(GetDataField(data, "profDept", "-"))
    role  := Trim(GetDataField(data, "profRole", "-"))
    
    if (dept == "") dept := "-"
    if (role == "") role := "-"
    
    sPTO  := SignPTO
    sIRC  := SignIRC
    sNUD  := SignNUD
    sRTU  := SignRTU
    sCPO  := SignCPO
    sSher := SignSheriff

    if (!RegExMatch(name, "^[а-яА-ЯёЁA-Za-z\s-]+$")) {
        return
    }
    if (!RegExMatch(badge, "^\d{5}$")) {
        return
    }
    if (pol == "" || pos == "" || dept == "" || role == "") {
        return
    }

    name := StrReplace(name, "|", " ")
    name := StrReplace(name, "`n", " ")
    name := StrReplace(name, "`r", " ")

    line := name . "|" . pol . "|" . pos . "|" . dept . "|" . role . "|" . badge
        . "|" . sPTO . "|" . sIRC . "|" . sNUD . "|" . sRTU . "|" . sCPO . "|" . sSher

    try {
        try FileDelete(ProfileFile)
        FileAppend(line, ProfileFile, "UTF-8")
    } catch as e {
        return
    }

    Name := name
    Pol := pol
    Position := pos
    Department := dept
    DeptRole := role
    Badge := badge
    SignPTO := sPTO
    SignIRC := sIRC
    SignNUD := sNUD
    SignRTU := sRTU
    SignCPO := sCPO
    SignSheriff := sSher
    UpdateDeptSign()
}

; ------------------------------------------------------------------------------
; Сохранение настроек из WebView
; ------------------------------------------------------------------------------
ProcessWebSettings(msg) {
    global SettingsFile, ChatOpenDelay, ChatSendDelay, TransLevel, MinecraftOnly
	global AccentColor := "#8b5cf6", EnableAnimations := 1
	
    data := ExtractMsgPayload(msg)
    if !IsObject(data)
        return

    openDelay := 250
    sendDelay := 250
    trans     := 150
    mcVal     := 0

    try {
        valOpen  := GetDataField(data, "setOpen", 250)
        valSend  := GetDataField(data, "setSend", 250)
        valTrans := GetDataField(data, "setTrans", 150)
        valMC    := GetDataField(data, "setMCOnly", 0)

        if IsNumber(valOpen)  && valOpen > 0
            openDelay := Integer(valOpen)
        if IsNumber(valSend)  && valSend > 0
            sendDelay := Integer(valSend)
        if IsNumber(valTrans) && valTrans > 0
            trans := Integer(valTrans)
        
        if (valMC == 1 || valMC == "1" || valMC == true)
            mcVal := 1
    } catch {
    }

    if (openDelay < 100 || openDelay > 5000) openDelay := 250
    if (sendDelay < 100 || sendDelay > 5000) sendDelay := 250
    if (trans < 50 || trans > 255) trans := 150

    ChatOpenDelay := openDelay
    ChatSendDelay := sendDelay
    TransLevel    := trans
    MinecraftOnly := mcVal

    try IniWrite(openDelay, SettingsFile, "General", "ChatOpenDelay")
    try IniWrite(sendDelay, SettingsFile, "General", "ChatSendDelay")
    try IniWrite(trans,     SettingsFile, "General", "TransLevel")
    try IniWrite(mcVal,     SettingsFile, "General", "MinecraftOnly")
}

